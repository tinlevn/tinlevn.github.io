---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { formatDate, getPublishedPosts } from "../../utils/collections";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = formatDate(post.data.pubDate);
---

<Base title={`${post.data.title} — Tin Le`} description={post.data.description}>
  <article>
    <a href="/blog/" class="text-sm font-medium text-indigo-600 hover:underline dark:text-indigo-400">
      &larr; All posts
    </a>

    <header class="mt-4">
      <h1 class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-white">
        {post.data.title}
      </h1>
      <time class="mt-2 block text-sm text-zinc-600 dark:text-zinc-400" datetime={post.data.pubDate.toISOString()}>
        {formattedDate}
      </time>
    </header>

    <hr class="my-8 border-zinc-200 dark:border-zinc-800" />

    <div class="prose prose-zinc max-w-none dark:prose-invert">
      <Content />
    </div>
  </article>
</Base>

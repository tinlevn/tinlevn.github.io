---
import Base from "../../layouts/Base.astro";
import { formatDate, getPublishedPosts } from "../../utils/collections";

const posts = await getPublishedPosts();
---

<Base
  title="Blog — Tin Le"
  description="Writing on software engineering, .NET, Angular, and whatever else I am learning."
>
  <header>
    <h1 class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-white">Blog</h1>
    <p class="mt-2 max-w-prose text-zinc-600 dark:text-zinc-400">
      Notes on software engineering and things I am learning along the way.
    </p>
  </header>

  {
    posts.length > 0 ? (
      <div class="mt-8 divide-y divide-zinc-200 dark:divide-zinc-800">
        {posts.map((post) => (
          <article class="py-6">
            <time class="text-xs text-zinc-600 dark:text-zinc-400" datetime={post.data.pubDate.toISOString()}>
              {formatDate(post.data.pubDate)}
            </time>
            <h2 class="mt-1 font-semibold text-zinc-900 dark:text-white">
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            </h2>
            <p class="mt-1 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
              {post.data.description}
            </p>
          </article>
        ))}
      </div>
    ) : (
      <p class="mt-8 rounded-xl border border-dashed border-zinc-300 p-8 text-center text-sm text-zinc-500 dark:border-zinc-700 dark:text-zinc-400">
        Nothing here yet — check back soon.
      </p>
    )
  }
</Base>

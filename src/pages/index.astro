---
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { resume } from "../data/resume";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base title={`${resume.fullName} — ${resume.headline}`} description={resume.summary}>
  <article class="space-y-12">
    <section>
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <h1 class="text-4xl font-bold tracking-tight text-zinc-900 dark:text-white">
            {resume.fullName}
          </h1>
          <p class="mt-1 text-lg text-zinc-500 dark:text-zinc-400">{resume.headline}</p>
        </div>
        <button
          id="print-btn"
          type="button"
          class="rounded-lg border border-zinc-300 bg-white px-3 py-1.5 text-sm font-medium text-zinc-700 shadow-sm transition hover:bg-zinc-100 print:hidden dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-800"
        >
          Print / Save PDF
        </button>
      </div>

      <ul class="mt-5 flex flex-wrap gap-2">
        {
          resume.contact.map((item) => (
            <li>
              {item.href ? (
                <a
                  href={item.href}
                  rel="noopener noreferrer"
                  target={item.href.startsWith("http") ? "_blank" : undefined}
                  class="inline-block rounded-full border border-zinc-200 bg-white px-3 py-1 text-sm text-zinc-600 transition hover:border-indigo-300 hover:text-indigo-600 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-400 dark:hover:border-indigo-700 dark:hover:text-indigo-400"
                >
                  <span class="font-medium text-zinc-500 dark:text-zinc-500">{item.label}:</span>{" "}
                  {item.value}
                </a>
              ) : (
                <span class="inline-block rounded-full border border-zinc-200 bg-white px-3 py-1 text-sm text-zinc-600 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-400">
                  <span class="font-medium text-zinc-500 dark:text-zinc-500">{item.label}:</span>{" "}
                  {item.value}
                </span>
              )}
            </li>
          ))
        }
      </ul>

      <p class="mt-6 max-w-prose leading-relaxed text-zinc-600 dark:text-zinc-400">
        {resume.summary}
      </p>
    </section>

    <section aria-labelledby="skills-heading">
      <h2
        id="skills-heading"
        class="text-xs font-semibold uppercase tracking-widest text-indigo-600 dark:text-indigo-400"
      >
        Skills
      </h2>
      <ul class="mt-4 flex flex-wrap gap-2">
        {
          resume.skills.map((skill) => (
            <li class="rounded-full bg-indigo-50 px-3 py-1 text-sm text-indigo-700 dark:bg-indigo-950/60 dark:text-indigo-300">
              {skill}
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="experience-heading">
      <h2
        id="experience-heading"
        class="text-xs font-semibold uppercase tracking-widest text-indigo-600 dark:text-indigo-400"
      >
        Experience
      </h2>
      <div class="mt-4 space-y-8">
        {
          resume.experience.map((job) => (
            <article class="break-inside-avoid">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                <h3 class="font-semibold text-zinc-900 dark:text-white">
                  {job.title} &middot; {job.company}
                </h3>
                <span class="text-xs text-zinc-500">{job.date}</span>
              </div>
              <p class="text-sm text-zinc-500">{job.location}</p>
              <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
                {job.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="projects-heading">
      <h2
        id="projects-heading"
        class="text-xs font-semibold uppercase tracking-widest text-indigo-600 dark:text-indigo-400"
      >
        Projects
      </h2>
      <div class="mt-4 grid gap-5 sm:grid-cols-2">
        {projects.slice(0, 2).map((project) => <ProjectCard project={project} />)}
      </div>
      {
        projects.length > 0 && (
          <a
            href="/projects/"
            class="mt-5 inline-block text-sm font-medium text-indigo-600 hover:underline dark:text-indigo-400"
          >
            View all projects &rarr;
          </a>
        )
      }
    </section>

    <section aria-labelledby="education-heading">
      <h2
        id="education-heading"
        class="text-xs font-semibold uppercase tracking-widest text-indigo-600 dark:text-indigo-400"
      >
        Education
      </h2>
      <div class="mt-4 space-y-6">
        {
          resume.education.map((edu) => (
            <article class="break-inside-avoid">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                <h3 class="font-semibold text-zinc-900 dark:text-white">{edu.institution}</h3>
                <span class="text-xs text-zinc-500">{edu.period}</span>
              </div>
              <p class="text-sm text-zinc-500">{edu.degree}</p>
              <p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
                {edu.details}
              </p>
            </article>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="awards-heading">
      <h2
        id="awards-heading"
        class="text-xs font-semibold uppercase tracking-widest text-indigo-600 dark:text-indigo-400"
      >
        Awards
      </h2>
      <ul class="mt-4 space-y-1.5 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
        {resume.awards.map((award) => <li>{award}</li>)}
      </ul>
    </section>
  </article>

  <script>
    document.getElementById("print-btn")?.addEventListener("click", () => window.print());
  </script>
</Base>

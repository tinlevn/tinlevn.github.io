---
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { resume } from "../data/resume";
import { getPublishedProjects } from "../utils/collections";

const projects = await getPublishedProjects();
---

<Base title={`${resume.fullName} — ${resume.headline}`} description={resume.summary}>
  <article class="space-y-12">
    <section class="animate-fade-in-up" style="animation-delay: 0.1s">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <h1
            id="scramble-name"
            class="scramble-target text-4xl font-bold tracking-tight text-zinc-900 dark:text-white tabular-nums"
            aria-label={resume.fullName}
          >
            {resume.fullName}
          </h1>
          <p
            id="scramble-headline"
            class="scramble-target mt-1 text-lg text-zinc-500 dark:text-zinc-400 tabular-nums"
            aria-label={resume.headline}
          >
            {resume.headline}
          </p>
        </div>
        <button
          id="print-btn"
          type="button"
          class="btn-layered-3d btn-layered-3d--green print:hidden"
          style="font-size: 0.6rem; padding: 0.3em 0.7em;"
        >
          Print PDF
        </button>
      </div>

      <ul class="mt-5 flex flex-wrap gap-2">
        {
          resume.contact.map((item) => (
            <li>
              {item.href ? (
                <a
                  href={item.href}
                  rel="noopener noreferrer"
                  target={item.href.startsWith("http") ? "_blank" : undefined}
                  class="inline-block rounded-full border border-zinc-200 bg-white px-3 py-1 text-sm text-zinc-600 transition hover:border-indigo-300 hover:text-indigo-600 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-400 dark:hover:border-indigo-700 dark:hover:text-indigo-400"
                >
                  <span class="font-medium text-zinc-600 dark:text-zinc-400">{item.label}:</span>{" "}
                  {item.value}
                </a>
              ) : (
                <span class="inline-block rounded-full border border-zinc-200 bg-white px-3 py-1 text-sm text-zinc-600 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-400">
                  <span class="font-medium text-zinc-600 dark:text-zinc-400">{item.label}:</span>{" "}
                  {item.value}
                </span>
              )}
            </li>
          ))
        }
      </ul>

      <p class="mt-6 max-w-prose leading-relaxed text-zinc-600 dark:text-zinc-400">
        {resume.summary}
      </p>
    </section>

    <section aria-labelledby="skills-heading" class="animate-fade-in-up" style="animation-delay: 0.2s">
      <h2
        id="skills-heading"
        class="text-xs font-semibold uppercase tracking-widest text-indigo-600 dark:text-indigo-400"
      >
        Skills <span class="ml-2 text-[10px] font-normal normal-case text-zinc-500 dark:text-zinc-400">(Drag to rearrange)</span>
      </h2>
      <ul id="skills-list" class="mt-4 flex flex-wrap items-center gap-2">
        {
          resume.skills.map((skill, i) => {
            const colors = [
              "bg-indigo-50 text-indigo-700 dark:bg-indigo-950/60 dark:text-indigo-300",
              "bg-pink-50 text-pink-700 dark:bg-pink-950/60 dark:text-pink-300",
              "bg-emerald-50 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300",
              "bg-blue-50 text-blue-700 dark:bg-blue-950/60 dark:text-blue-300",
              "bg-amber-50 text-amber-700 dark:bg-amber-950/60 dark:text-amber-300"
            ];
            const colorClass = colors[i % colors.length];
            return (
              <li
                draggable="true"
                aria-label={`Skill: ${skill}`}
                class={`draggable-skill rounded-full px-3 py-1 text-sm cursor-grab active:cursor-grabbing hover:-translate-y-1 hover:scale-105 transition-all duration-300 shadow-sm hover:shadow-md ${colorClass}`}
              >
                {skill}
              </li>
            );
          })
        }
      </ul>
    </section>

    <section aria-labelledby="experience-heading" class="animate-fade-in-up" style="animation-delay: 0.3s">
      <h2
        id="experience-heading"
        class="text-xs font-semibold uppercase tracking-widest text-indigo-600 dark:text-indigo-400"
      >
        Experience
      </h2>
      <div class="mt-4 space-y-8">
        {
          resume.experience.map((job) => (
            <article class="break-inside-avoid hover:shadow-lg hover:-translate-y-1 transition-all duration-300 rounded-xl p-5 -mx-5 bg-transparent hover:bg-white dark:hover:bg-zinc-900">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                <h3 class="font-semibold text-zinc-900 dark:text-white inline-block">
                  {job.title} <span class="mx-1 text-zinc-500 dark:text-zinc-400 text-[10px]">&bull;</span> {job.company}
                </h3>
                <span class="text-xs text-zinc-600 dark:text-zinc-400">{job.period}</span>
              </div>
              <p class="text-sm text-zinc-600 dark:text-zinc-400">{job.location}</p>
              <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
                {job.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="projects-heading" class="animate-fade-in-up" style="animation-delay: 0.4s">
      <h2
        id="projects-heading"
        class="text-xs font-semibold uppercase tracking-widest text-indigo-600 dark:text-indigo-400"
      >
        Projects
      </h2>
      <div class="mt-4 grid gap-5 sm:grid-cols-2">
        {projects.slice(0, 2).map((project) => <ProjectCard project={project} />)}
      </div>
      {
        projects.length > 2 && (
          <a
            href="/projects/"
            class="mt-5 inline-block text-sm font-medium text-indigo-600 hover:underline dark:text-indigo-400"
          >
            View all projects &rarr;
          </a>
        )
      }
    </section>

    <section aria-labelledby="education-heading" class="animate-fade-in-up" style="animation-delay: 0.5s">
      <h2
        id="education-heading"
        class="text-xs font-semibold uppercase tracking-widest text-indigo-600 dark:text-indigo-400"
      >
        Education
      </h2>
      <div class="mt-4 space-y-6">
        {
          resume.education.map((edu) => (
            <article class="break-inside-avoid hover:shadow-lg hover:-translate-y-1 transition-all duration-300 rounded-xl p-5 -mx-5 bg-transparent hover:bg-white dark:hover:bg-zinc-900">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                <h3 class="font-semibold text-zinc-900 dark:text-white">{edu.institution}</h3>
                <span class="text-xs text-zinc-600 dark:text-zinc-400">{edu.period}</span>
              </div>
              <p class="text-sm text-zinc-600 dark:text-zinc-400">{edu.degree}</p>
              <p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
                {edu.details}
              </p>
            </article>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="awards-heading" class="animate-fade-in-up" style="animation-delay: 0.6s">
      <h2
        id="awards-heading"
        class="text-xs font-semibold uppercase tracking-widest text-indigo-600 dark:text-indigo-400"
      >
        Awards
      </h2>
      <ul class="mt-4 space-y-1.5 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
        {resume.awards.map((award) => <li>{award}</li>)}
      </ul>
    </section>
  </article>

  <script>
    class TextScramble {
      el: HTMLElement;
      chars: string;
      frameRequest: number | null;

      constructor(el: HTMLElement) {
        this.el = el;
        this.chars = "!<>-_\\/[]{}=+*^?#$%&@~|;:,.·";
        this.frameRequest = null;
      }

      setText(newText: string): Promise<void> {
        const oldText = this.el.textContent ?? "";
        const length = Math.max(oldText.length, newText.length);
        const staggerMs = 110;
        const churnMs = 900;

        if (this.frameRequest) cancelAnimationFrame(this.frameRequest);

        return new Promise((resolve) => {
          const startTime = performance.now();

          const update = () => {
            const elapsed = performance.now() - startTime;
            let output = "";
            let complete = 0;

            for (let i = 0; i < length; i++) {
              const from = oldText[i] ?? "";
              const to = newText[i] ?? "";

              if (to === " ") {
                output += " ";
                complete++;
              } else if (elapsed >= i * staggerMs + churnMs) {
                output += to;
                complete++;
              } else if (!to && elapsed >= i * staggerMs) {
                output += "";
                complete++;
              } else if (elapsed >= i * staggerMs) {
                output += this.chars[Math.floor(Math.random() * this.chars.length)];
              } else {
                output += from;
                complete++;
              }
            }

            this.el.textContent = output;

            if (complete === length) {
              resolve();
            } else {
              this.frameRequest = requestAnimationFrame(update);
            }
          };

          update();
        });
      }
    }

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const nameEl = document.getElementById("scramble-name");
    const headlineEl = document.getElementById("scramble-headline");

    if (!prefersReducedMotion && nameEl && headlineEl) {
      const nameTarget = nameEl.getAttribute("aria-label") ?? nameEl.textContent ?? "";
      const headlineTarget = headlineEl.getAttribute("aria-label") ?? headlineEl.textContent ?? "";

      const fxName = new TextScramble(nameEl);
      const fxHeadline = new TextScramble(headlineEl);

      setTimeout(() => {
        fxName.setText(nameTarget);
        setTimeout(() => fxHeadline.setText(headlineTarget), 250);
      }, 150);
    }

    document.getElementById("print-btn")?.addEventListener("click", () => window.print());

    // Drag-to-reorder skills (pointer events: works on mouse, touch, and pen)
    const skillsList = document.getElementById("skills-list");
    if (skillsList && !prefersReducedMotion) {
      const DRAG_TRANSITION = "transform 300ms cubic-bezier(0.34, 1.56, 0.64, 1)";
      let draggedItem: HTMLElement | null = null;

      const onPointerDown = (e: PointerEvent) => {
        if (e.pointerType === "mouse" && e.button !== 0) return;
        const target = e.target;
        if (target instanceof HTMLElement && target.classList.contains("draggable-skill")) {
          draggedItem = target;
          target.setPointerCapture(e.pointerId);
          target.classList.add("is-dragging");
        }
      };

      const onPointerMove = (e: PointerEvent) => {
        if (!draggedItem) return;
        e.preventDefault();

        const initialRects = new Map<Element, DOMRect>();
        const items = Array.from(
          skillsList.querySelectorAll(".draggable-skill:not(.is-dragging)")
        ) as HTMLElement[];
        items.forEach((item) => {
          initialRects.set(item, item.getBoundingClientRect());
          item.style.transition = "none";
        });

        const afterElement = getDragAfterElement(skillsList, e.clientX, e.clientY);
        if (afterElement == null) {
          skillsList.appendChild(draggedItem);
        } else if (draggedItem !== afterElement) {
          skillsList.insertBefore(draggedItem, afterElement);
        }

        items.forEach((item) => {
          const initialRect = initialRects.get(item);
          if (!initialRect) return;
          const finalRect = item.getBoundingClientRect();
          const deltaX = initialRect.left - finalRect.left;
          const deltaY = initialRect.top - finalRect.top;

          if (deltaX !== 0 || deltaY !== 0) {
            item.style.transform = `translate(${deltaX}px, ${deltaY}px)`;
            requestAnimationFrame(() => {
              item.style.transition = DRAG_TRANSITION;
              item.style.transform = "translate(0, 0)";
            });
          }
        });
      };

      const endDrag = () => {
        if (!draggedItem) return;
        draggedItem.classList.remove("is-dragging");
        draggedItem = null;
        const items = skillsList.querySelectorAll(".draggable-skill") as NodeListOf<HTMLElement>;
        items.forEach((item) => {
          item.style.transform = "";
          item.style.transition = "";
        });
      };

      skillsList.addEventListener("pointerdown", onPointerDown);
      skillsList.addEventListener("pointermove", onPointerMove);
      skillsList.addEventListener("pointerup", endDrag);
      skillsList.addEventListener("pointercancel", endDrag);

      function getDragAfterElement(container: HTMLElement, x: number, y: number): Element | null {
        const elements = container.querySelectorAll(".draggable-skill:not(.is-dragging)");
        let closest = null;
        let closestDistance = Number.POSITIVE_INFINITY;
        elements.forEach((child) => {
          const box = child.getBoundingClientRect();
          const dx = x - (box.left + box.width / 2);
          const dy = y - (box.top + box.height / 2);
          const distance = Math.sqrt(dx * dx + dy * dy);
          if (distance < closestDistance) {
            closestDistance = distance;
            closest = child;
          }
        });
        return closest;
      }
    }
  </script>
</Base>

---
import Base from "../layouts/Base.astro";
import Resume from "../components/Resume.astro";
import { resume } from "../data/resume";
---

<Base title={`${resume.fullName} — ${resume.headline}`} description={resume.summary}>
  <h1
    slot="header-title"
    id="scramble-name"
    class="page-title animate-fade-in-up text-4xl tabular-nums"
    style="animation-delay: 0.1s"
    aria-label={resume.fullName}
  >
    {resume.fullName}
  </h1>
  <Resume />
  <script>
    import { initHomePage } from "../scripts/home";

    document.addEventListener("astro:page-load", initHomePage);
  </script>
</Base>

---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
  robots?: string;
}

const {
  title,
  description = "Portfolio and resume of Tin Le, full-stack software engineer specializing in C#, ASP.NET Core, Angular, and Azure.",
  robots = "index, follow",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og-image.svg", Astro.site);
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

const navItems = [
  { href: "/", label: "CV" },
  { href: "/projects/", label: "Projects" },
  { href: "/about/", label: "About" },
];

function normalize(p: string): string {
  return p.replace(/\/+$/, "") || "/";
}

function isActive(href: string): boolean {
  const target = normalize(href);
  if (target === "/") return path === "/";
  return path === target || path.startsWith(`${target}/`);
}

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#18181b" />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Tin Le" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <ClientRouter />
  </head>
  <body
    class="flex min-h-screen flex-col bg-zinc-50 font-sans text-zinc-800 antialiased dark:bg-zinc-950 dark:text-zinc-200"
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:rounded-lg focus:bg-indigo-600 focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>
    <div aria-hidden="true" class="fixed inset-0 -z-10 pointer-events-none bg-gradient-to-br from-indigo-100/40 via-transparent to-purple-100/40 dark:from-indigo-900/20 dark:via-transparent dark:to-purple-900/20"></div>
    <header
      class="sticky top-0 z-10 border-b border-zinc-200 bg-zinc-50/80 backdrop-blur print:hidden dark:border-zinc-800 dark:bg-zinc-950/80"
    >
      <div class="mx-auto flex h-14 w-full max-w-3xl items-center justify-between px-4 sm:px-6">
        <a
          href="/"
          class="text-sm font-semibold tracking-tight text-zinc-900 transition hover:text-indigo-600 dark:text-white dark:hover:text-indigo-400"
        >
          Tin Le
        </a>
        <nav aria-label="Main navigation">
          <ul class="flex items-center gap-1 sm:gap-2">
            {
              navItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={isActive(item.href) ? "page" : undefined}
                    class:list={[
                      "btn-top-3d",
                      isActive(item.href)
                        ? "btn-top-3d--nav-active"
                        : "btn-top-3d--nav",
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="mx-auto w-full max-w-3xl flex-1 px-4 py-10 sm:px-6">
      <slot />
    </main>

    <footer class="border-t border-zinc-200 print:hidden dark:border-zinc-800">
      <div
        class="mx-auto flex w-full max-w-3xl flex-col items-center justify-between gap-2 px-4 py-6 text-sm text-zinc-500 sm:flex-row sm:px-6 dark:text-zinc-400"
      >
        <p>&copy; {year} Tin Le. All rights reserved.</p>
        <div class="flex items-center gap-4">
          <a
            href="https://github.com/tinlevn"
            class="transition hover:text-zinc-900 dark:hover:text-white"
            rel="noopener noreferrer"
            target="_blank"
          >
            GitHub
          </a>
          <a
            href="https://astro.build"
            class="transition hover:text-zinc-900 dark:hover:text-white"
            rel="noopener noreferrer"
            target="_blank"
          >
            Built with Astro
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>

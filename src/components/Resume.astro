---
import ProjectCard from "./ProjectCard.astro";
import ContactChip from "./ContactChip.astro";
import Section from "./Section.astro";
import { resume } from "../data/resume";
import { getPublishedProjects } from "../utils/collections";
import { CV_DOWNLOAD_URL } from "../data/site";

const projects = await getPublishedProjects();

const skillColors = [
  "bg-indigo-50 text-indigo-700 dark:bg-indigo-950/60 dark:text-indigo-300",
  "bg-pink-50 text-pink-700 dark:bg-pink-950/60 dark:text-pink-300",
  "bg-emerald-50 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300",
  "bg-blue-50 text-blue-700 dark:bg-blue-950/60 dark:text-blue-300",
  "bg-amber-50 text-amber-700 dark:bg-amber-950/60 dark:text-amber-300",
] as const;
---

<article class="stagger-in space-y-12">
  <section>
    <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
      <p
        id="scramble-headline"
        class="scramble-target text-lg text-zinc-500 dark:text-zinc-400 tabular-nums"
        aria-label={resume.headline}
      >
        {resume.headline}
      </p>
      <a
        href={CV_DOWNLOAD_URL}
        download
        class="btn-layered-3d btn-layered-3d--green btn-layered-3d--sm print:hidden"
      >
        Download CV
      </a>
    </div>

    <ul class="mt-5 flex flex-wrap gap-2">
      {resume.contact.map((item) => <ContactChip item={item} />)}
    </ul>

    <p class="mt-6 max-w-prose leading-relaxed text-zinc-600 dark:text-zinc-400">
      {resume.summary}
    </p>
  </section>

  <Section id="skills-heading" title="Skills">
    <ul class="flex flex-wrap items-center gap-x-1 gap-y-2">
      {
        resume.skills.map((skill, i) => (
          <li class="flex items-center gap-x-1">
            <span class:list={["rounded-full px-3 py-1 text-sm", skillColors[i % skillColors.length]]}>
              {skill}
            </span>
            {i < resume.skills.length - 1 && (
              <span aria-hidden="true" class="select-none text-zinc-300 dark:text-zinc-600">
                ·
              </span>
            )}
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="experience-heading" title="Experience">
    <div class="space-y-8">
      {
        resume.experience.map((job) => (
          <article class="resume-card">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4">
              <h3 class="inline-block font-semibold text-zinc-900 dark:text-white">
                {job.title}{" "}
                <span class="mx-1 text-[10px] text-zinc-500 dark:text-zinc-400">&bull;</span>{" "}
                {job.company}
              </h3>
              <span class="text-xs text-zinc-600 dark:text-zinc-400">{job.period}</span>
            </div>
            <p class="text-sm text-zinc-600 dark:text-zinc-400">{job.location}</p>
            <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
              {job.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </Section>

  <Section id="projects-heading" title="Projects">
    <div class="grid gap-5 sm:grid-cols-2">
      {projects.slice(0, 2).map((project) => <ProjectCard project={project} />)}
    </div>
    {
      projects.length > 2 && (
        <a
          href="/projects/"
          class="mt-5 inline-block text-sm font-medium text-indigo-600 hover:underline dark:text-indigo-400"
        >
          View all projects &rarr;
        </a>
      )
    }
  </Section>

  <Section id="education-heading" title="Education">
    <div class="space-y-6">
      {
        resume.education.map((edu) => (
          <article class="resume-card">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4">
              <h3 class="font-semibold text-zinc-900 dark:text-white">{edu.institution}</h3>
              <span class="text-xs text-zinc-600 dark:text-zinc-400">{edu.period}</span>
            </div>
            <p class="text-sm text-zinc-600 dark:text-zinc-400">{edu.degree}</p>
            <p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{edu.details}</p>
          </article>
        ))
      }
    </div>
  </Section>

  <Section id="awards-heading" title="Awards">
    <ul class="space-y-1.5 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
      {resume.awards.map((award) => <li>{award}</li>)}
    </ul>
  </Section>
</article>
